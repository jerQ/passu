menu "passu"

    config DW_BUTTON_GPIO
        int "Trigger button GPIO"
        default 0
        range 0 48
        help
            GPIO of a push button wired to GND (internal pull-up is enabled).
            GPIO0 is the BOOT button on most ESP32 dev boards.

    config DW_GROUPS
        int "Number of word+digit groups"
        default 8
        range 5 16
        help
            Each group is one EFF word (five d6 rolls) plus one digit 0-9,
            about 16.25 bits per group. 8 groups is about 130 bits; the
            minimum of 5 is about 81 bits.

    config DW_SERIAL_TRIGGER
        bool "Also generate on Enter in the serial console"
        default y

    config DW_WORDLIST_SHA256
        string "Expected SHA-256 of eff_large_wordlist.txt (hex)"
        default "addd35536511597a02fa0a9ff1e5284677b8883b83e986e43f15a3db996b903e"
        help
            The build fails, and boot halts, unless the embedded wordlist
            matches this hash. The default is the published hash of the EFF
            large wordlist. Leave empty to skip both checks (not recommended).

    config DW_LOCKDOWN_ACK
        bool "I understand that Secure Boot eFuse changes are PERMANENT"
        depends on SECURE_BOOT
        default n
        help
            Secure Boot is enabled, so the first boot of this firmware burns
            eFuses that can never be reset:

            - BLOCK2 key digest: only firmware signed with this one key will
              ever run. Losing the key means no more updates, ever.
            - ABS_DONE_1: Secure Boot is on for good.
            - JTAG_DISABLE: no JTAG debugging, ever.
            - CONSOLE_DEBUG_DISABLE: no ROM BASIC console.
            - WR_DIS_EFUSE_RD_DISABLE: no eFuse can be read-protected
              later, so flash encryption can't be added.
            - UART_DOWNLOAD_DIS (if download mode is set to "Permanently
              disabled"): esptool and espefuse can never connect again, so
              the board can't be reflashed or recovered over USB.

            A mistake can leave the board unusable. Read "Locking down a
            device" in SECURITY.md and try a spare board first. The build
            refuses to run until this is set.

    menuconfig DW_DISPLAY
        bool "OLED display"
        default n
        help
            Show passphrases on a 128-pixel-wide I2C OLED: SSD1306 (0.91"
            128x32 and 0.96" 128x64 modules), SSD1309 (2.42") or SH1106
            (1.3" 128x64).

    if DW_DISPLAY

    choice DW_DISPLAY_CONTROLLER
        prompt "Display controller"
        default DW_DISPLAY_SSD1306
        help
            0.91" and 0.96" modules are usually SSD1306, 1.3" modules
            usually SH1106. On the wrong setting an SH1106 shows a column of
            noise at one edge and the image shifted by 2 pixels.

        config DW_DISPLAY_SSD1306
            bool "SSD1306 / SSD1309"
        config DW_DISPLAY_SH1106
            bool "SH1106"
    endchoice

    choice DW_DISPLAY_SIZE
        prompt "Display size"
        default DW_DISPLAY_128X64

        config DW_DISPLAY_128X64
            bool "128x64"
        config DW_DISPLAY_128X32
            bool "128x32 (up to 8 groups)"
    endchoice

    config DW_DISPLAY_HEIGHT
        int
        default 64 if DW_DISPLAY_128X64
        default 32

    config DW_DISPLAY_I2C_ADDR
        hex "I2C address"
        default 0x3C
        range 0x08 0x77
        help
            7-bit address. Usually 0x3C; some modules use 0x3D (often set
            with a solder jumper on the back).

            Modules often print the 8-bit form instead: 0x78 means 0x3C and
            0x7A means 0x3D (the 7-bit address shifted left by one).

    config DW_DISPLAY_SDA
        int "SDA GPIO"
        default 21
        range 0 48

    config DW_DISPLAY_SCL
        int "SCL GPIO"
        default 22
        range 0 48

    config DW_DISPLAY_ROTATE
        bool "Rotate 180 degrees"
        default n

    config DW_DISPLAY_CLEAR_S
        int "Clear the passphrase after (seconds)"
        default 60
        range 5 600
        help
            The screen also clears when the button is pressed while a
            passphrase is shown.

    config DW_SERIAL_PASSPHRASE
        bool "Also print passphrases over serial"
        default y
        help
            Turn off to keep passphrases away from the computer entirely.
            The serial port then only says that a passphrase was shown on
            the display, and `passu` reports that instead of a passphrase.

    endif

endmenu
